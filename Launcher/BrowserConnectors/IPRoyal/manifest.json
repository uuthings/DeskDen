{
  "manifest_version": 3,
  "name": "方寸 · IPRoyal 用量助手",
  "version": "1.0.0",
  "description": "仅将 IPRoyal 静态 ISP 订单的流量额度同步到本机方寸。",
  "minimum_chrome_version": "111",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://dashboard.iproyal.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "方寸 IPRoyal 连接",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.iproyal.com/me/orders/*"
      ],
      "js": [
        "protocol.js",
        "observer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://dashboard.iproyal.com/me/orders/*"
      ],
      "js": [
        "protocol-isolated.js",
        "content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
