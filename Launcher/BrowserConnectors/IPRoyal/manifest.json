{
  "manifest_version": 3,
  "name": "DeskDen IPRoyal Connector",
  "version": "0.1",
  "description": "Sync IPRoyal static ISP traffic allowances to DeskDen on your Mac.",
  "minimum_chrome_version": "111",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://dashboard.iproyal.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DeskDen IPRoyal Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "64": "icon-64.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.iproyal.com/me/orders/*"
      ],
      "js": [
        "protocol.js",
        "observer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://dashboard.iproyal.com/me/orders/*"
      ],
      "js": [
        "protocol-isolated.js",
        "content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
